#!/bin/bash
## screening-criterion check (EBIC with log n versus log events); NTASK filled in by hpc/submit_screencmp.sh
#BSUB -J "acihscr[1-NTASK]%300"
#BSUB -q medium
#BSUB -W 4:00
#BSUB -n 1
#BSUB -M 24G
#BSUB -R "rusage[mem=24] span[hosts=1]"
#BSUB -o logs/scr.%J.%I.out
#BSUB -e logs/scr.%J.%I.err
module load R/4.5.1
cd $LS_SUBCWD
export R_LIBS=${ACIH_LIB:-$HOME/Rlib}${R_LIBS:+:$R_LIBS}
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript acih.R screencmp $LSB_JOBINDEX
