#!/bin/bash
## data applications, step 1: preprocessing (raw files in app/data/, see README)
#BSUB -J acih_app_prepare
#BSUB -q medium
#BSUB -W 4:00
#BSUB -n 1
#BSUB -M 16G
#BSUB -R "rusage[mem=16] span[hosts=1]"
#BSUB -o logs/app_prepare.%J.out
#BSUB -e logs/app_prepare.%J.err
module load R/4.5.1
cd $LS_SUBCWD
export R_LIBS=${ACIH_LIB:-$HOME/Rlib}${R_LIBS:+:$R_LIBS}
if [ -f app/data/msk_met_2021/data_clinical_patient.txt ]; then Rscript app/msk_met_prepare.R; fi
if [ -f app/data/nhis/samadult_2016.csv ]; then Rscript app/nhis_lmf_prepare.R; fi
