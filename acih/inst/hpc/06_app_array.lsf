#!/bin/bash
## data applications, step 2: one split of one cohort per task; NTASK is
## filled in by hpc/submit_apps.sh
#BSUB -J "acihapp[1-NTASK]%300"
#BSUB -q medium
#BSUB -W 4:00
#BSUB -n 1
#BSUB -M 16G
#BSUB -R "rusage[mem=16] span[hosts=1]"
#BSUB -o logs/app.%J.%I.out
#BSUB -e logs/app.%J.%I.err
module load R/4.5.1
cd $LS_SUBCWD
export R_LIBS=${ACIH_LIB:-$HOME/Rlib}${R_LIBS:+:$R_LIBS}
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript acih.R app $LSB_JOBINDEX
