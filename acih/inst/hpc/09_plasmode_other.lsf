#!/bin/bash
## plasmode study: preparation or summary (STEP is filled in by hpc/submit_plasmode.sh)
#BSUB -J acih_pls_STEP
#BSUB -q medium
#BSUB -W 4:00
#BSUB -n 1
#BSUB -M 16G
#BSUB -R "rusage[mem=16] span[hosts=1]"
